CONFIG_ENV=config.env

# ======================
# Kernel 基本配置
# ======================
KERNEL_SOURCE=https://github.com/rsuntkOrgs/kernel_samsung_wingtech
KERNEL_SOURCE_BRANCH=android-4.19-stable
KERNEL_CONFIG=rsuntk-a04_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false

# ======================
# Clang 编译器配置
# ======================
USE_CUSTOM_CLANG=false
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

# 警告忽略已移至 YAML，此处仅保留核心指令
EXTRA_CMDS="LD=ld.lld"
CUSTOM_CMDS="CLANG_TRIPLE=aarch64-linux-gnu-"

# ======================
# GCC 交叉编译器配置
# ======================
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
USE_CUSTOM_GCC_32=false

# ======================
# SukiSU-Ultra 配置
# ======================
ENABLE_KERNELSU=true
KERNELSU_TAG=main

# ======================
# 功能开关
# ======================
DISABLE-LTO=true
DISABLE_CC_WERROR=true
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
APPLY_KSU_PATCH=false
REMOVE_UNUSED_PACKAGES=true

# ======================
# 打包配置 (注意链接已修复)
# ======================
USE_CUSTOM_ANYKERNEL3=false
ENABLE_CCACHE=true
NEED_DTBO=false
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/wenjiejs-sourc/KernelSU_Action/raw/A04/boot.img
