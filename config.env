CONFIG_ENV=config.env

# ======================
# Kernel 基本配置
# ======================
KERNEL_SOURCE=https://github.com/rsuntkOrgs/kernel_samsung_wingtech
KERNEL_SOURCE_BRANCH=android-4.19-stable
KERNEL_CONFIG=rsuntk-a04_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false

# ======================
# Clang 编译器配置
# ======================
# 使用 Android 12/13 官方通用的 Clang 版本
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 这里去掉 KCFLAGS，只保留 LD=ld.lld
EXTRA_CMDS="LD=ld.lld"
CUSTOM_CMDS="CLANG_TRIPLE=aarch64-linux-gnu-"

# 下载链接拼接变量
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

# ======================
# GCC 交叉编译器配置 (用于辅助 Clang)
# ======================
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-

USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# ======================
# SukiSU-Ultra (原 KernelSU 配置)
# ======================
ENABLE_KERNELSU=true
# 对于 SukiSU-Ultra，通常指向 main 分支
KERNELSU_TAG=main

# ======================
# 内核功能 / 编译开关
# ======================
# 禁用 LTO 可以大幅提高编译成功率并缩短耗时
DISABLE-LTO=true
# 必须禁用 Werror，否则三星源码中的警告会导致报错停止
DISABLE_CC_WERROR=true
# 开启 KPROBES 和 OVERLAYFS 是 SukiSU/KSU 正常运行的基础
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
# ⚠️ 这里改为 false，因为我们在 YAML 中使用了 SukiSU 的 setup.sh 自动集成
APPLY_KSU_PATCH=false
# 清理工作流磁盘空间
REMOVE_UNUSED_PACKAGES=true

# ======================
# AnyKernel3 打包配置
# ======================
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ======================
# 其他优化
# ======================
ENABLE_CCACHE=true
NEED_DTBO=false

# ======================
# Boot.img 构建配置
# ======================
# 如果你提供原厂 boot.img，脚本会尝试合成
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/wenjiejs-sourc/KernelSU_Action/blob/A04/boot.img
